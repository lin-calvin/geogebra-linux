{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeoGebra",
  "version": "0.1.0",
  "identifier": "org.geogebra.linux",
  "build": {
    "frontendDist": "../webapp"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GeoGebra",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
